pipeline {
    agent any

    stages {

        stage('VM Information') {
            steps {
                sh '''
                    echo "===== VM INFORMATION ====="
                    echo "Hostname : $(hostname)"
                    echo "User     : $(whoami)"
                    echo "IP Addr  : $(hostname -I)"
                    echo "Working Directory : $(pwd)"
                    echo "=========================="
                '''
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Show Repository') {
            steps {
                sh 'ls -R'
            }
        }

        stage('Validate Ansible Role') {
            steps {
                sh '''
                    test -d nginx/defaults
                    test -d nginx/tasks
		    test -d nginx/tests
                    test -d nginx/handlers
                    test -d nginx/vars
                    test -d nginx/meta

                    echo "Ansible role structure is valid."
                '''
            }
        }

        stage('Check Ansible') {
            steps {
                sh 'ansible --version'
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully."
        }
        failure {
            echo "Pipeline failed."
        }
    }
}
